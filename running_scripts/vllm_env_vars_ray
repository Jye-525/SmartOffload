NODE_IFACE="hsn0"
export HOST_IP=`ip -4 addr show $NODE_IFACE | grep -oP '(?<=inet\s)\d+(\.\d+){3}'`

# ray related env variables
export RAY_TMPDIR=/tmp/vllm_jye/vllm_ray
export VLLM_WORKER_MULTIPROC_METHOD=fork
export OMP_NUM_THREADS=1
export RAY_COLOR_PREFIX=0
export RAY_DEDUP_LOGS=0

# vLLM related variables
export VLLM_HOST_IP=$HOST_IP
export VLLM_RPC_BASE_PATH=/tmp/vllm_jye/vllm_ipc/
export TRITON_CACHE_DIR=/tmp/vllm_jye/triton_cache/
export VLLM_CACHE_ROOT=/tmp/vllm_jye/vllm_cache/
export TOKENIZERS_PARALLELISM=false
export VLLM_LOGGING_LEVEL=INFO
export NCCL_SOCKET_IFNAME=$IF_NAME
export GLOO_SOCKET_IFNAME=$IF_NAME
export VLLM_ENGINE_ITERATION_TIMEOUT_S=300
# export NCCL_DEBUG=TRACE
export VLLM_USE_V1=1
export CUDA_MODULE_LOADING=EAGER # EAGER or LAZY

# Used for avinash_offload
# export VLLM_USE_SMART_OFFLOADING=0
export VLLM_SMART_OFFLOAD_KVCACHE=0
# export VLLM_USE_SMART_OFFLOADING_K=0
export VLLM_ENABLE_LAYER_FWD_TIMING=0
## schedule_method: default, cost-aware, evict-optimal, evict-optimal-2, evict-optimal-3 
export VLLM_V1_SCHEDULE_METHOD="default"
export VLLM_V1_TRACK_REQUETS=1
export VLLM_V1_ADAPTIVE_MAX_NUM_REQS=0

export VLLM_V1_SCHED_STATS=1
export VLLM_V1_SCHED_STATS_PATH=/home/jye/moe_mix_precision/running_scripts/sched_stats.csv
export VLLM_V1_SCHED_STATS_FLUSH_EVERY_N=0

export VLLM_V1_REQ_STATS_ENABLED=1
export VLLM_V1_REQ_STATS_CSV_PATH=/home/jye/moe_mix_precision/running_scripts/req_stats.csv


[ -d $RAY_TMPDIR ] || mkdir -p $RAY_TMPDIR
[ -d $VLLM_RPC_BASE_PATH ] || mkdir -p $VLLM_RPC_BASE_PATH
